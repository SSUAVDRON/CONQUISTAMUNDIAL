# Solo se sirven rangos.php, cuentas.php y social.php: ni las piezas internas
# (comun.php, sesion.php y social-comun.php) ni
# bases de datos u otros archivos
<FilesMatch "\.(sqlite|sqlite-wal|sqlite-shm|sal|db|log)$">
  Require all denied
</FilesMatch>
<FilesMatch "^(comun|sesion|social-comun)\.php$">
  Require all denied
</FilesMatch>
