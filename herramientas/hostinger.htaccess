# Trinchera en Hostinger (LiteSpeed). Lo copia herramientas/hostinger.sh a la rama «hostinger».
DirectoryIndex index.html

# Hostinger despliega con Git y deja la carpeta .git junto a la web: que no se pueda leer
RedirectMatch 404 /\.git

# El juego cambia a menudo: el navegador comprueba siempre si hay versión nueva
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Comprimido viaja mucho menos (el juego es un único HTML de ~2,6 MB)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
